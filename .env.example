# JARVIS settings. scripts/setup.sh copies this to .env and fills it in.
# JARVIS 的設定檔。scripts/setup.sh 會把它複製成 .env 並幫你填好。

# Optional: Fish Audio key — the JARVIS voice from the films (paid, fish.audio).
# Leave it empty and JARVIS speaks with the browser's own voice, for free.
# 選填：Fish Audio 金鑰＝電影版 JARVIS 聲音（付費）。留空＝瀏覽器內建語音（免費）。
FISH_API_KEY=

# The language JARVIS hears and speaks: zh-TW (Mandarin, Traditional Chinese
# as written in Taiwan) or en (the original British butler, in English).
# 對話語言：zh-TW（中文，台灣繁體）或 en（原版英國管家，英文）。
JARVIS_LANGUAGE=zh-TW

# Which voice speaks: auto (Fish Audio when there is a key, otherwise the
# browser's built-in voice — and the browser also covers any sentence Fish
# could not voice), fish (Fish Audio or nothing), browser (never Fish Audio).
# 語音引擎：auto（有金鑰用 Fish Audio，沒有就用瀏覽器語音）、fish、browser。
JARVIS_TTS=auto

# Optional: which of the browser's voices to use, by part of its name — e.g.
# Meijia or "Google 國語" for Mandarin, Daniel for English. Empty picks one for
# you (a Taiwan Mandarin voice for zh-TW, a British one for en).
# 選填：指定瀏覽器語音的名稱（部分即可），留空會自動挑選。
# JARVIS_BROWSER_VOICE=Meijia

# JARVIS's brain is a Claude Code process running on YOUR Claude subscription.
# Install Claude Code (2.1.224+) and log in with `claude` — no Anthropic API
# key is needed for anything, and any ANTHROPIC_* variable set here is
# deliberately hidden from the brain so it can only use your login.
# JARVIS 的大腦是跑在你 Claude 訂閱上的 Claude Code，不需要任何 API 金鑰。

# Optional: which model the brain runs (default sonnet; always passed explicitly)
# JARVIS_BRAIN_MODEL=sonnet

# Optional: Fish Audio voice model (defaults to JARVIS MCU voice)
# FISH_VOICE_ID=612b878b113047d9a770c069c8b4fdfe

# Optional: Your name (JARVIS will address you by name)
# 選填：你的名字（JARVIS 會用名字稱呼你）
# USER_NAME=Tony

# Optional: Whether to skip Claude CLI permission prompts on subprocess calls.
# Defaults to "true" because JARVIS is voice-driven and cannot respond to
# interactive permission prompts (they would silently hang the subprocess).
# Set to "false" to require explicit permission prompts — only useful when
# running JARVIS interactively in a Terminal you can see and respond to.
# JARVIS_SKIP_PERMISSIONS=true

# Optional: Override the auto-detected weather location.
# By default, JARVIS uses your public-IP location (via ipwho.is) and reports
# Fahrenheit. Set these to pin a specific location:
# WEATHER_LOCATION_LABEL=Taipei
# WEATHER_LATITUDE=25.0330
# WEATHER_LONGITUDE=121.5654
# celsius or fahrenheit (no comment after a value: it would become part of it)
# WEATHER_UNIT=celsius
